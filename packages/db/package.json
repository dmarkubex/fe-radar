{
  "name": "@fe-radar/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "migrate": "tsx scripts/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:mock": "tsx scripts/seed-mock-data.ts",
    "seed:release": "tsx scripts/seed-release-data.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "verify:sources": "tsx scripts/verify-sources.ts"
  },
  "dependencies": {
    "@fe-radar/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "playwright": "^1.59.1"
  }
}
