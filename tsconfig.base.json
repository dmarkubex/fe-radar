{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@fe-radar/core": ["packages/core/src/index.ts"],
      "@fe-radar/db": ["packages/db/src/index.ts"],
      "@fe-radar/llm": ["packages/llm/src/index.ts"],
      "@fe-radar/shared": ["packages/shared/src/index.ts"]
    }
  }
}
