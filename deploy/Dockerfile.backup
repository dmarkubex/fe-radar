FROM alpine:3.22

RUN apk add --no-cache postgresql16-client ca-certificates curl \
  && curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
  && chmod +x /usr/local/bin/mc

COPY scripts/minio-backup.sh /scripts/minio-backup.sh
RUN chmod +x /scripts/minio-backup.sh

ENTRYPOINT ["/scripts/minio-backup.sh"]
