# syntax=docker/dockerfile:1.7
# FE-Radar 一次性迁移 / seed 镜像（G2）。
# runner（web/worker）镜像不含 tsx 与 db 脚本，故用本镜像跑 packages/db 的迁移/seed。
#
# 用法（stack 部署后，在能连 internal overlay 的 manager 节点）：
#   # 1) 建表 + seed ~75 个 enabled 信源（migrate.ts 顺序执行 migrations/*.sql）
#   docker run --rm --network fe-radar_internal \
#     -e DATABASE_URL='postgres://fe_radar:<DBPW>@postgres:5432/fe_radar' \
#     harborssl.fegroup.cn/custom-project/fe-radar-migrate:latest
#   # 2) 建后台登录账号（可用 SEED_ADMIN_USERNAME / SEED_ADMIN_PASSWORD 指定）
#   docker run --rm --network fe-radar_internal \
#     -e DATABASE_URL='postgres://fe_radar:<DBPW>@postgres:5432/fe_radar' \
#     -e SEED_ADMIN_USERNAME=admin -e SEED_ADMIN_PASSWORD='<strong-pw>' \
#     harborssl.fegroup.cn/custom-project/fe-radar-migrate:latest pnpm --filter @fe-radar/db seed:admin
#
# 注意：不设 NODE_ENV=production，否则 pnpm 跳过 devDependencies → tsx 缺失，迁移无法运行。

ARG NODE_SLIM_IMAGE=docker.m.daocloud.io/library/node:22-slim
ARG NPM_REGISTRY=https://registry.npmmirror.com
FROM ${NODE_SLIM_IMAGE}
ENV TZ=Asia/Shanghai
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ARG NPM_REGISTRY
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}
ARG PNPM_VERSION=11.0.9
WORKDIR /app

RUN command -v pnpm >/dev/null || npm install -g pnpm@${PNPM_VERSION} --registry=${NPM_REGISTRY} --no-audit --no-fund

# workspace 清单 + lockfile，最大化层缓存
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json tsconfig.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/llm/package.json packages/llm/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/shared/package.json packages/shared/package.json

# T4 缺口修复：re2（T4 引入，仅 apps/worker 需要）编译需要 make/g++，本镜像没有该
# 工具链。之前的无过滤 install 会把 apps/worker 的完整依赖图（含 re2）一起装进来，
# 预编译下载失败后 fallback node-gyp rebuild 必炸。用 --filter 只装 @fe-radar/db
# 及其依赖（同 Dockerfile.web 的 B-2 手法），另加 --filter=. 保留根 package.json 的
# tsx（迁移/seed 脚本运行时依赖，只在根声明，db 包自身未声明，纯 db 过滤会漏装）。
RUN pnpm config set registry ${NPM_REGISTRY} && \
    pnpm install --frozen-lockfile --child-concurrency=1 --filter=@fe-radar/db... --filter=.

# db 包源码（migrations/*.sql + scripts/*.ts）
COPY packages ./packages

# 默认：建表 + seed 信源。seed:admin 通过 override command 调用（见文件头用法）。
CMD ["pnpm", "--filter", "@fe-radar/db", "migrate"]
