NODE_ENV=production
TZ=Asia/Shanghai
DATABASE_URL=postgres://fe_radar:${DB_PASSWORD}@postgres:5432/fe_radar
REDIS_URL=redis://redis:6379
NEXTAUTH_URL=http://fe-radar.internal
NEXTAUTH_SECRET_FILE=/run/secrets/nextauth_secret
DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
KIMI_API_KEY_FILE=/run/secrets/kimi_api_key
QWEN_BASE_URL=http://qwen-internal.example.com/v1
QWEN_MODEL=qwen3.6-27b
DINGTALK_APP_SECRET_FILE=/run/secrets/dingtalk_app_secret
PROXY_POOL_ENABLED=false
PROXY_LIST_FILE=/run/secrets/proxy_list
BRIEFING_TEMPLATE_PATH=/app/design/templates/briefing.docx
BRIEFING_MINIO_BUCKET=fe-radar-briefings
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY_FILE=/run/secrets/minio_root_user
MINIO_SECRET_KEY_FILE=/run/secrets/minio_root_password
GRAFANA_DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=CHANGE_ME
