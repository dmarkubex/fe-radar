NODE_ENV=production
TZ=Asia/Shanghai
DATABASE_URL=postgres://fe_radar:${DB_PASSWORD}@postgres:5432/fe_radar
REDIS_URL=redis://redis:6379
NEXTAUTH_URL=http://fe-radar.internal
NEXTAUTH_SECRET_FILE=/run/secrets/nextauth_secret
MIROFISH_API_BASE_URL=http://mirofish:5001
MIROFISH_WEB_BASE_URL=http://<server-ip>:3001
MIROFISH_PUBLIC_API_BASE_URL=http://<server-ip>:5001
MIROFISH_REQUEST_TIMEOUT_MS=300000
MIROFISH_WEB_PORT=3001
MIROFISH_API_PORT=5001
MIROFISH_LLM_API_KEY=CHANGE_ME
MIROFISH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIROFISH_LLM_MODEL_NAME=qwen-plus
MIROFISH_ZEP_API_KEY=CHANGE_ME
MIROFISH_SECRET_KEY=CHANGE_ME
DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
KIMI_API_KEY_FILE=/run/secrets/kimi_api_key
# Firecrawl C1 风险检索（0024 默认 enabled；部署前创建 secret）：
#   docker secret create firecrawl_api_key <(printf 'fc-xxx')
# FIRECRAWL_API_KEY_FILE=/run/secrets/firecrawl_api_key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
QWEN_BASE_URL=http://qwen-internal.example.com/v1
QWEN_MODEL=qwen3.6-27b
DINGTALK_CORP_ID=dingxxxxxxxxxxxxxxxx
DINGTALK_APP_SECRET_FILE=/run/secrets/dingtalk_app_secret
PROXY_POOL_ENABLED=false
PROXY_LIST_FILE=/run/secrets/proxy_list
BRIEFING_TEMPLATE_PATH=/app/design/templates/briefing.docx
BRIEFING_MINIO_BUCKET=fe-radar-briefings
# 合并日报钉钉推送调度（启停 / HH:mm / 每日|工作日 / baseUrl）存 DB 表 daily_push_config，默认 enabled=false；不在此硬编码发送时间
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY_FILE=/run/secrets/minio_root_user
MINIO_SECRET_KEY_FILE=/run/secrets/minio_root_password
GRAFANA_DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=CHANGE_ME
