# syntax=docker/dockerfile:1.7
# FE-Radar worker (BullMQ consumer：fetcher / pipeline / scheduler / cleanup) 多阶段构建
# 说明：
#  - worker 通过 `tsc -p tsconfig.json` 编译到 dist/。因 tsconfig.base.json 的 paths 将
#    @fe-radar/* 解析到 packages/*/src，tsc 把 packages 源码纳入编译图，实际产物路径为
#    dist/apps/worker/src/main.js（与 scheduler-main.js 同级），并非裸 dist/main.js。
#    本镜像 WORKDIR=/app/apps/worker，故 `node dist/apps/worker/src/main.js` 即真实入口。
#  - fetcher 使用 Playwright（chromium.launch headless）。Playwright 自带的 Chromium 需要
#    glibc，alpine(musl) 无法运行，故运行期基于 node:22-slim（glibc）。
#  - 这是新增文件，不影响正在运行的应用。

# ---------- deps：安装 monorepo 依赖 ----------
ARG NODE_SLIM_IMAGE=docker.m.daocloud.io/library/node:22-slim
ARG NPM_REGISTRY=https://registry.npmmirror.com
# 默认 http，避免 runner 在未装 ca-certificates 时 apt https 验签失败
ARG DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
# Playwright 浏览器走官方 CDN（cdn.playwright.dev，版本最全）；
# npmmirror 镜像未同步 playwright 1.59 的 build v1217（404），故不用国内镜像源。
# 如需切回 npmmirror：docker build --build-arg PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
ARG PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.playwright.dev
FROM ${NODE_SLIM_IMAGE} AS deps
ENV TZ=Asia/Shanghai
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ARG NPM_REGISTRY
ARG DEBIAN_MIRROR
ARG DEBIAN_SECURITY_MIRROR
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}
ARG PNPM_VERSION=11.0.9
WORKDIR /app

RUN command -v pnpm >/dev/null || npm install -g pnpm@${PNPM_VERSION} --registry=${NPM_REGISTRY} --no-audit --no-fund

# T4 / re2 原生模块编译链（仅 deps 阶段，不进 runner）：
# - python3: node-gyp 驱动脚本
# - make / g++: 编译 re2 C++ 绑定（当 GitHub 预编译 artifact 不可用时 fallback）
# re2 的 install 脚本会先尝试下载 prebuilt，失败再 node-gyp rebuild。
# 编译产物 .node 随 node_modules COPY 到 runner，runner 不需要本工具链。
# 先换源再 apt：该 RUN 内的安装即走 DEBIAN_MIRROR（默认 http，无 CA 也可）
RUN sed -i \
      -e "s#http://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g" \
      -e "s#http://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
      /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/llm/package.json packages/llm/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/shared/package.json packages/shared/package.json

# re2 在 root package.json onlyBuiltDependencies + pnpm-workspace allowBuilds 中已放行，
# 否则 pnpm 11 会静默跳过 install 脚本 → 运行期找不到 re2.node。
RUN pnpm config set registry ${NPM_REGISTRY} && \
    pnpm install --frozen-lockfile --child-concurrency=1

# ---------- builder：tsc 编译 worker ----------
FROM ${NODE_SLIM_IMAGE} AS builder
ENV TZ=Asia/Shanghai
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ARG NPM_REGISTRY
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}
ARG PNPM_VERSION=11.0.9
WORKDIR /app

RUN command -v pnpm >/dev/null || npm install -g pnpm@${PNPM_VERSION} --registry=${NPM_REGISTRY} --no-audit --no-fund

# 复用 deps 已装好的 node_modules（含 re2 原生 .node）；builder 只跑 tsc，
# 不再二次编译原生模块，故此处不重复装 python3/make/g++。
COPY --from=deps /app ./

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker

RUN pnpm --filter @fe-radar/worker build

# ---------- playwright-browsers：只下浏览器二进制，BuildKit cache 跨构建复用 ----------
# 与 runner 拆开的原因：
#  - 旧写法在 runner 里 `playwright install --with-deps`，deps/node_modules 或 apt 层一变
#    整段 RUN 重做 → 每次从 CDN 再拉 ~112MB chromium-headless-shell。
#  - 本阶段：install 时 PLAYWRIGHT_BROWSERS_PATH 指向 cache mount；命中缓存则秒级跳过下载，
#    再 cp 进镜像层 /ms-playwright。同一台构建机上只要 Playwright 大版本未变，就不再公网下载。
#  - 仅当 pnpm-lock / playwright 版本变化导致本阶段失效且 cache 无对应 build 时才重新下载。
FROM deps AS playwright-browsers
ARG PLAYWRIGHT_DOWNLOAD_HOST
ENV PLAYWRIGHT_DOWNLOAD_HOST=${PLAYWRIGHT_DOWNLOAD_HOST}
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0
WORKDIR /app
# worker 仅 headless（fetchers/playwright.ts）；1.59 用 chromium-headless-shell，比完整 chromium 小。
RUN --mount=type=cache,id=fe-radar-playwright-browsers,target=/pw-dl-cache,sharing=locked \
    PLAYWRIGHT_BROWSERS_PATH=/pw-dl-cache \
    ./apps/worker/node_modules/.bin/playwright install chromium-headless-shell && \
    mkdir -p /ms-playwright && \
    cp -a /pw-dl-cache/. /ms-playwright/ && \
    test -x /ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell

# ---------- runner：精简运行期镜像（浏览器从上一阶段 COPY，OS 依赖单独装） ----------
FROM ${NODE_SLIM_IMAGE} AS runner
ENV TZ=Asia/Shanghai
ENV NODE_ENV=production
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ARG NPM_REGISTRY
ARG DEBIAN_MIRROR
ARG DEBIAN_SECURITY_MIRROR
ARG PLAYWRIGHT_DOWNLOAD_HOST
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}
ENV PLAYWRIGHT_DOWNLOAD_HOST=${PLAYWRIGHT_DOWNLOAD_HOST}
ARG PNPM_VERSION=11.0.9
# Playwright 浏览器安装到固定路径，便于 root 安装、非 root 运行
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app

RUN command -v pnpm >/dev/null || npm install -g pnpm@${PNPM_VERSION} --registry=${NPM_REGISTRY} --no-audit --no-fund

# 复用 deps 的 node_modules（含 playwright npm 包）；浏览器二进制来自 playwright-browsers 缓存阶段。
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY apps/worker/package.json ./apps/worker/package.json
COPY --from=playwright-browsers /ms-playwright /ms-playwright

# OS 依赖 + postgresql-client；install-deps 只装系统库，不再下载浏览器。
# apt 使用 BuildKit cache，避免每次全量重拉 deb。
# 先换源再 apt：ca-certificates / postgresql-client / playwright OS deps 均走镜像。
RUN --mount=type=cache,id=fe-radar-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=fe-radar-apt-lists,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    sed -i \
      -e "s#http://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g" \
      -e "s#http://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
      /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates postgresql-client && \
    ./apps/worker/node_modules/.bin/playwright install-deps chromium-headless-shell && \
    test -x /ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell

# 拷贝编译产物与 worker package.json（提供 `start` 脚本与运行期元信息）
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY apps/worker/register-aliases.mjs ./apps/worker/register-aliases.mjs
# NODE_OPTIONS 只在运行时生效：放在 register-aliases.mjs COPY 之后，
# 避免构建期的 npm/pnpm 启动 node 时 import 尚不存在的文件而崩溃。
ENV NODE_OPTIONS="--import /app/apps/worker/register-aliases.mjs"
COPY design/templates ./design/templates

# 读取 Docker *_FILE 密钥到纯 env（DEEPSEEK_API_KEY_FILE→DEEPSEEK_API_KEY 等）；
# 未设 *_FILE 时为 no-op，故纯 env 部署不受影响。
COPY --chmod=0755 deploy/docker-entrypoint-secrets.sh /usr/local/bin/fe-entrypoint.sh
# 防御性归一化：若构建宿主以 CRLF 检出脚本（Windows / core.autocrlf），shebang 会变成
# `#!/bin/sh\r`，内核找不到解释器 → 容器以
# `exec /usr/local/bin/fe-entrypoint.sh: no such file or directory` 崩溃。
RUN sed -i 's/\r$//' /usr/local/bin/fe-entrypoint.sh && chmod 0755 /usr/local/bin/fe-entrypoint.sh

# 非 root 运行，浏览器目录授予可读执行
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -m worker && \
    mkdir -p /ms-playwright && chown -R worker:nodejs /ms-playwright
USER worker

WORKDIR /app/apps/worker

# 默认入口 worker；scheduler 服务复用同镜像并在 stack.yml override command 为
# ["node", "dist/apps/worker/src/scheduler-main.js"]。ENTRYPOINT 负责 *_FILE 密钥注入，
# command override 会作为参数透传给它。
ENTRYPOINT ["/usr/local/bin/fe-entrypoint.sh"]
CMD ["node", "dist/apps/worker/src/main.js"]
