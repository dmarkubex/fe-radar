# syntax=docker/dockerfile:1.7
# FE-Radar web (Next.js 15 App Router) 多阶段构建
# 说明：apps/web/next.config.js 未启用 output:'standalone'，
#       且 transpilePackages 直接编译 packages/* 的 TS 源码，
#       因此运行期用 `next start` 启动，无需 server.js。
# 这是新增文件，不影响正在运行的应用。

# ---------- deps：安装 monorepo 依赖（带缓存的 frozen install） ----------
ARG NODE_WEB_IMAGE=docker.m.daocloud.io/library/node:22-slim
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
FROM ${NODE_WEB_IMAGE} AS deps
ENV TZ=Asia/Shanghai
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ARG NPM_REGISTRY
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}
ARG PNPM_VERSION=11.0.9
WORKDIR /app

RUN command -v pnpm >/dev/null || npm install -g pnpm@${PNPM_VERSION} --registry=${NPM_REGISTRY} --no-audit --no-fund

# 仅拷贝 workspace 清单 + lockfile，最大化 Docker 层缓存命中率
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/llm/package.json packages/llm/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/shared/package.json packages/shared/package.json

# corepack 按 package.json 的 packageManager 字段锁定 pnpm 版本
# B-2: --filter=@fe-radar/web... 只安装 web 及其 workspace 依赖（core/db/shared），
# 不安装 apps/worker 的依赖图 → re2（worker 专属，预编译下载失败会 fallback
# node-gyp rebuild，而本镜像无 python3/make/g++）不会被拉入 web 镜像。
# 保留所有 COPY package.json：pnpm 需读取完整 workspace 清单才能解析依赖图。
RUN pnpm config set registry ${NPM_REGISTRY} && \
    pnpm install --frozen-lockfile --child-concurrency=1 --filter=@fe-radar/web...

# ---------- builder：编译 Next.js ----------
FROM ${NODE_WEB_IMAGE} AS builder
ENV TZ=Asia/Shanghai
ENV NEXT_TELEMETRY_DISABLED=1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ARG NPM_REGISTRY
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}
ARG PNPM_VERSION=11.0.9
WORKDIR /app

RUN command -v pnpm >/dev/null || npm install -g pnpm@${PNPM_VERSION} --registry=${NPM_REGISTRY} --no-audit --no-fund

# 复用 deps 阶段已安装好的 node_modules（含 workspace 软链）
COPY --from=deps /app ./

# 拷贝构建所需源码（web 通过 transpilePackages 直接编译 packages/* 源码）
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm --filter @fe-radar/web build

# ---------- runner：精简运行期镜像 ----------
FROM ${NODE_WEB_IMAGE} AS runner
ENV TZ=Asia/Shanghai
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ARG NPM_REGISTRY
ARG DEBIAN_MIRROR
ARG DEBIAN_SECURITY_MIRROR
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}
ARG PNPM_VERSION=11.0.9

# 先换源再 apt：默认 DEBIAN_MIRROR 为 http://，slim 无 CA 也可拉包。
# 若 build-arg 传 https:// 且镜像尚无 ca-certificates，apt 会 Certificate verification failed。
RUN sed -i \
      -e "s#http://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g" \
      -e "s#https://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g" \
      -e "s#http://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
      -e "s#https://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
      /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates postgresql-client && \
    rm -rf /var/lib/apt/lists/* && \
    (command -v pnpm >/dev/null || npm install -g pnpm@${PNPM_VERSION} --registry=${NPM_REGISTRY} --no-audit --no-fund) && \
    groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -m nextjs

# 运行 `next start` 需要：根 node_modules（next CLI + 运行期依赖）、
# web 包的 node_modules（软链至 workspace 包）、构建产物 .next、
# package.json/next.config.js，以及 packages/* 源码
# （transpilePackages 在运行期仍按源码解析 @fe-radar/* 模块）。
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next ./apps/web/.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/package.json ./apps/web/package.json
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/next.config.js ./apps/web/next.config.js
COPY --from=builder --chown=nextjs:nodejs /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/tsconfig.base.json /app/tsconfig.json ./
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages

# 读取 Docker *_FILE 密钥到纯 env（NEXTAUTH_SECRET_FILE→NEXTAUTH_SECRET 等）；
# 未设 *_FILE 时为 no-op，故纯 env 部署不受影响。
COPY deploy/docker-entrypoint-secrets.sh /usr/local/bin/fe-entrypoint.sh
# 防御性归一化：若构建宿主以 CRLF 检出脚本（Windows / core.autocrlf），shebang 会变成
# `#!/bin/sh\r`，内核找不到解释器 → 容器以
# `exec /usr/local/bin/fe-entrypoint.sh: no such file or directory` 崩溃。
RUN sed -i 's/\r$//' /usr/local/bin/fe-entrypoint.sh && chmod 0755 /usr/local/bin/fe-entrypoint.sh

USER nextjs

WORKDIR /app/apps/web
EXPOSE 3000

# next start（next.config.js 未配置 standalone，故不使用 server.js）
ENTRYPOINT ["/usr/local/bin/fe-entrypoint.sh"]
CMD ["pnpm", "start"]
