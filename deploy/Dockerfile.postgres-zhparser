ARG PGVECTOR_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
FROM ${PGVECTOR_IMAGE}

# 与 worker/web 一致用 http:// 默认：base 缺 ca-certificates 时也可先 sed 再 apt。
# 若 build-arg 传 https:// 且尚未装 CA，apt 会 Certificate verification failed。
ARG DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security

# zhparser 在 PGDG / Debian 源里没有预编译 deb 包，必须源码编译。
# 依赖链：postgresql-server-dev-16（提供 pg_config + PGXS）→ SCWS（中文分词库）→ zhparser
# 先换源再 apt：ca-certificates + 编译依赖均走 DEBIAN_MIRROR，避免内网拉 deb.debian.org 极慢。
RUN set -eux; \
    sed -i \
      -e "s#http://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g" \
      -e "s#http://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
      /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        postgresql-server-dev-16 \
        build-essential \
        wget bzip2 git; \
    \
    # 2) 编译安装 SCWS 1.2.3（zhparser 的分词库）
    wget -q https://www.xunsearch.com/scws/down/scws-1.2.3.tar.bz2 -O /tmp/scws.tar.bz2; \
    mkdir -p /tmp/scws; \
    tar xjf /tmp/scws.tar.bz2 -C /tmp/scws --strip-components=1; \
    cd /tmp/scws; \
    ./configure --prefix=/usr/local; \
    make -j"$(nproc)"; \
    make install; \
    ldconfig; \
    \
    # 3) 编译安装 zhparser
    git clone --depth 1 https://github.com/amutu/zhparser.git /tmp/zhparser; \
    cd /tmp/zhparser; \
    SCWS_HOME=/usr/local PG_CONFIG=/usr/lib/postgresql/16/bin/pg_config make; \
    make install; \
    \
    # 4) 清理源码与构建工具，缩小镜像（zhparser.so / .control / dict 已 install 进 PG 目录）
    cd /; \
    rm -rf /tmp/scws /tmp/scws.tar.bz2 /tmp/zhparser; \
    apt-get purge -y --auto-remove build-essential postgresql-server-dev-16 wget bzip2 git; \
    rm -rf /var/lib/apt/lists/*
