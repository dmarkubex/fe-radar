# PYTHON_IMAGE digest 未知：保持 3.11-slim 标签，合入时由 infra 填 digest，不要编造 sha256。
# 禁止 --target 0（无名 stage 在 BuildKit 会 target not found）。
ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.5.11
FROM ${UV_IMAGE} AS uv
ARG UV_IMAGE
FROM ${PYTHON_IMAGE}
ARG PYTHON_IMAGE
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY apps/copilot/pyproject.toml apps/copilot/uv.lock ./
RUN UV_INDEX_URL=${PIP_INDEX_URL} UV_NATIVE_TLS=1 uv sync --frozen --no-dev --index-url ${PIP_INDEX_URL}
COPY apps/copilot/ ./
CMD [".venv/bin/python", "main.py"]
