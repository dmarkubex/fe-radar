{
  "name": "fe-radar",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @fe-radar/web dev",
    "labels:m2": "tsx scripts/m2-label-evaluator.ts",
    "lint": "pnpm -r lint",
    "prepare": "husky || true",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "madge": "madge --ts-config tsconfig.base.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --max-warnings=0",
    "*.{json,md,css,yml,yaml}": "prettier --check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  }
}
